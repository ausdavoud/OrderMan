# Spacefile Docs: https://go.deta.dev/docs/spacefile/v0
v: 0
app_name: MyOrder
micros:
  - name: bot
    src: bot
    engine: python3.9
    run: uvicorn main:app
    dev: uvicorn main:app --reload
    primary: true
    public_routes:
      - "/open"
    presets:
      env:
        - name: TELEGRAM_BOT_TOKEN
          description: Telegram Bot Key

  - name: deta
    src: deta
    # primary: true
    engine: python3.9
    run: uvicorn main:app
    dev: uvicorn main:app --reload
    actions:
      - id: "update"
        name: "Update"
        description: "Adds unsaved data to csv file"
        trigger: "schedule"
        default_interval: "0 12 * * *"
      
    public_routes:
      - "/put_items"
      - "/put_breads"
      - "/update_csv"
      - "/get_breads_csv"
      - "/get_items_csv"
      - "/get_preorders.csv"
